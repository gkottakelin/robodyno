WorldInfo {
  basicTimeStep 4
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [
        0.8
      ]
      maxContactJoints 24
    }
  ]
}

Viewpoint {
  orientation -0.577350 0.577350 0.577350 2.094395
  position 0.05 -0.15 1.15
  description "Province scene overview"
}

Background {
  skyColor [
    0.78 0.82 0.88
  ]
}

DirectionalLight {
  direction -0.4 -0.5 -1
  intensity 1.8
  castShadows TRUE
}

Solid {
  translation -0.12 0.12 -0.016
  name "floor"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.86 0.86 0.82
        roughness 1
        metalness 0
      }
      geometry Box {
        size 1.1 1.1 0.01
      }
    }
  ]
  boundingObject Box {
    size 1.1 1.1 0.01
  }
}

# Base boards. Top surfaces are at Z = 0.
BaseBoard {
  translation 0 0 -0.01
  name "base_board_robot"
  locked TRUE
}
BaseBoard {
  translation 0 0.35 -0.01
  name "base_board_pick"
  locked TRUE
}
BaseBoard {
  translation -0.35 0 -0.01
  name "base_board_place"
  locked TRUE
}

