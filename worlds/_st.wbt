# Acrylic placing table, 350 mm x 175 mm x 10 mm.
Solid {
  translation -0.2625 0 0.005
  name "place_table"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.92 0.58 0.88
        transparency 0.35
        roughness 0.4
        metalness 0
      }
      geometry Box {
        size 0.175 0.35 0.01
      }
    }
  ]
  boundingObject Box {
    size 0.175 0.35 0.01
  }
}

# Four material boxes on the pick table.
MaterialBox {
  translation -0.0975 0.21 0.01
  name "material_box_1"
  locked TRUE
}
MaterialBox {
  translation 0.0475 0.21 0.01
  name "material_box_2"
  locked TRUE
}
MaterialBox {
  translation -0.0975 0.28 0.01
  name "material_box_3"
  locked TRUE
}
MaterialBox {
  translation 0.0475 0.28 0.01
  name "material_box_4"
  locked TRUE
}

# Two placing trays on the placing table.
MaterialTray {
  translation -0.2625 0.0875 0.01
  name "material_tray_top"
  locked TRUE
}
MaterialTray {
  translation -0.2625 -0.0875 0.01
  name "material_tray_bottom"
  locked TRUE
}

# Sample provincial-stage materials: 4 types, 2 identical pieces per box.
DEF CUBE_1 Cube {
  translation -0.13 0.21 0.021
  name "cube_1"
}
DEF CUBE_2 Cube {
  translation -0.065 0.21 0.021
  name "cube_2"
}
DEF CUBOID_1 Cuboid {
  translation 0.015 0.21 0.021
  name "cuboid_1"
}
DEF CUBOID_2 Cuboid {
  translation 0.08 0.21 0.021
  name "cuboid_2"
}
DEF FIVE_POINTED_1 FivePointed {
  translation -0.13 0.28 0.022
  name "five_pointed_1"
}
DEF FIVE_POINTED_2 FivePointed {
  translation -0.065 0.28 0.022
  name "five_pointed_2"
}
DEF PENTAGONAL_1 Pentagonal {
  translation 0.015 0.28 0.021
  name "pentagonal_1"
}
DEF PENTAGONAL_2 Pentagonal {
  translation 0.08 0.28 0.021
  name "pentagonal_2"
}

# Robot and vision system.
FourDofScaraRobot {
  translation 0 0 0
  # Face the corner between the pick table (+Y) and placing table (-X).
  # 135 deg avoids turning to the opposite/right side of the base board.
  rotation 0 0 1 2.35619449
  name "scara"
  sliderInitPose 0.25
  upperarmLength 0.15
  forearmLength 0.15
  controller "slider_test"
  supervisor TRUE
  endChildren [
    Vacuum_Gripper {
      name "vacuum_gripper"
      vacuum_id "0x21"
    }
  ]
}

RobodynoCamera {
  translation -0.032 0.245 0.45
  rotation 0.707 0.707 0 3.14159
  name "top_camera"
  cameraId "camera"
  width 640
  height 480
  controller "camera_viewer"
}
